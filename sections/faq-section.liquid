{% liquid
    assign heading = section.settings.heading
    assign subheading = section.settings.subheading
    assign background_color = section.settings.bg_color
    assign font_size = section.settings.heading_font_size
    assign question_font_size = section.settings.question_font_size
    assign margin_bottom = section.settings.margin_bottom
    assign margin_top = section.settings.margin_top
    assign answer_font_size = section.settings.answer_font_size
    assign border_color= section.settings.border_color
    assign answer_line_height = section.settings.answer_line_height
    assign question_line_height = section.settings.question_line_height
    assign heading_color = section.settings.heading_color
    assign subheading_color = section.settings.subheading_color
    assign question_color = section.settings.question_color
    assign answer_color = section.settings.answer_color
  %}
{% style %}
    .remove-spacing{
        margin:0;
    }
.module-faq__question-container {
    color: {{question_color}};
    cursor: pointer;
    padding: 20px;
    width: 100%;
    border: none;
    text-align: left;
    outline: none;
    font-size: {{question_font_size}}px;
    line-height: {{question_font_size}}px;
    line-height: {{question_line_height}}px;
    transition: 0.4s;
    border-top:1px solid #eee;
    border-top:1px solid {{  border_color }};
  }
  .module-faq__answer-container {
    padding: 0 20px 0 0;
    display: none;
    overflow: hidden;
    opacity:0;
    transition: opacity 0.3s ease-in-out;
    background: #fff;
  }
  .module__faq--heading {
      margin-bottom: 30px;
      margin-bottom: 25px;
  }
  .module-faq__question{
      color: {{question_color}};
      width: 80%;
      font-weight: 500;
  }
  .module-faq__answer{
      color: {{answer_color}};
      padding: 15px 35px 25px 35px;
      width: 100%;
      font-weight: 300;
  }
  .module__faq.Container {
    margin-bottom: {{margin_bottom}}px;
    margin-top: {{margin_top}}px;
    max-width: 1160px;
    padding-top:20px;
    padding-bottom:20px;
  }
  .module-faq__question-container:after {
    content: '\002B';
    color: {{ border_color }};
    font-weight: 300;
    float: right;
    left: 98.7%;
    left: 96.6%;
    top: 5px;
    position: absolute;
    font-size: 33px;
  }
  .module-faq__question-container.active {
    color: #fff!important;
    background: {{  border_color }};
    border-radius: 15px 15px 0px 0;
}
.active.module-faq__question-container:after {
    color: #fff;
}
.active .module-faq__question {
    color: #fff;
}
  .module-faq__question-container.active:after {
    content: "\2212";
  }
  .module-faq__item {
      position: relative;
  }
    .faq-section{
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding-top: {{ section.settings.padding_top }}px!important;
        padding-bottom: {{ section.settings.padding_bottom }}px!important;
    }
    p.description.faq-description {
        width: 75%;
        margin: auto;
        margin-bottom: 35px;
    }

    .module__faq--heading.heading-all {
        margin-bottom: 15px;
    }
    @media screen and (max-width: 980px) {
        .faq-section{
            padding-top: {{ section.settings.padding_top_tablet }}px!important;
            padding-bottom:
         {{ section.settings.padding_bottom_tablet }}px!important;
        }
        p.description.faq-description {
            width: 95%;
        }
    }
  @media screen and (max-width: 580px) {
    .faq-section{
        padding-top: {{ section.settings.padding_top_mobile }}px!important;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px!important;
    }
        .module-faq__question-container:after{
            left: 92%;
        }
        .module-faq__answer, .module-faq__question{
            width: 100%;
        }
        .module-faq__answer {
            padding: 15px 15px 25px 15px;
        }
        .module-faq__question-container {
            padding: 20px 20px 20px 15px;
        }
        .module-faq__answer-container{
            padding: 0 20px 0 0;
        }
        .module__faq.Container {
            padding: 0 18px;
        }
        p.description.faq-description {
            width: 100%;
        }
    }   
{% endstyle %}
<section class="faq-section" id="{{section.id }}" style="background: {{background_color}};">
<div class="module__faq Container page-width">
    {% if heading != blank%}
        <h2 class="module__faq--heading heading-all h1" style="color: {{ heading_color }}; text-align:center;">{{ heading }}</h2>
        <p class="description faq-description" style="color: {{ subheading_color }}; text-align:center;">{{ subheading }}</p>
    {% endif %}
    {%- for block in section.blocks -%}
        {% liquid
            assign faq_question = block.settings.faq_question
            assign faq_answer = block.settings.faq_answer
        %}
        <div class="module-faq__item">
            <div class="module-faq__question-container">
                <p class="module-faq__question remove-spacing">{{ faq_question }}</p>
            </div>
            <div class="module-faq__answer-container">
                <p class="module-faq__answer remove-spacing" >{{ faq_answer }}</p>
            </div>
        </div>
    {%- endfor -%}
</div>
<section>
<script>
    var question = document.getElementsByClassName("module-faq__question-container");
    var i;
    for (i = 0; i < question.length; i++) {
        question[i].addEventListener("click", function() {
        this.classList.toggle("active");
        var answer = this.nextElementSibling;
        if (answer.style.display === "block") {
            answer.style.display = "none";
            answer.style.opacity = 0;
        } else {
            answer.style.display = "block";
            answer.style.opacity = 1;
        }
        
      });
    }
    </script>
{% schema %}
{
    "name": "FAQ Section",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "FAQ"
        },
        {
            "type": "text",
            "id": "subheading",
            "label": "Subheading"
        },
        {
            "type": "header",
            "content": "Color Area"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color"
        },
        {
            "type": "color",
            "id": "subheading_color",
            "label": "Heading Color"
        },
        {
            "type": "color",
            "id": "question_color",
            "label": "Question Color"
        },
        {
            "type": "color",
            "id": "answer_color",
            "label": "Answer Color"
        },
        {
            "type": "color",
            "id": "border_color",
            "label": "Border Color"
        },
        {
            "type": "header",
            "content": "Padding Area"
          },
          {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Padding Top",
            "default": 80
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Padding Bottom",
            "default": 80
          },
          {
            "type": "range",
            "id": "padding_top_tablet",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Tablet Padding Top",
            "default": 50
          },
          {
            "type": "range",
            "id": "padding_bottom_tablet",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Tablet Padding Bottom",
            "default": 50
          },
          {
            "type": "range",
            "id": "padding_top_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Mobile Padding Top",
            "default": 30
          },
          {
            "type": "range",
            "id": "padding_bottom_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Mobile Padding Bottom",
            "default": 30
          }
    ],
    "blocks": [
        {
            "name": "FAQ Item",
            "type": "faq_section",
            "settings": [
                {
                    "type": "textarea",
                    "id": "faq_question",
                    "label": "FAQ Question",
                    "default": "Lorem ipsum dolor sit amet consectetur, adipisicing elit?"
                },
                {
                    "type": "textarea",
                    "id": "faq_answer",
                    "label": "FAQ Answer",
                    "default": "Lorem ipsum dolor sit amet consectetur adipisicing elit. In, nulla? Suscipit corrupti nemo consequuntur necessitatibus sunt perferendis, dolores consectetur itaque quas eum enim nulla, laborum laboriosam, provident commodi odit animi!"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "FAQ Section",
            "category": "FAQ"
        }
    ]
} 
{% endschema %}