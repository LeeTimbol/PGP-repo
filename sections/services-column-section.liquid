{%- style -%}
 .service-columns-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 35px;
    }
    .service-columns-description {
        padding-left: 10%;
    }
    a.service-button.button-y {
        margin-right: 15px;
    }
  .service-columns-image-item {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-start;
    }
    .service-columns-image-background {
        height: 100%;
        min-width: 23%;
        max-width: 23%;
        margin-right: 2%;
        background-size: cover;
        background-position: center;
        box-shadow: rgba(255, 255, 255, 0.1) 0px 1px 1px 0px inset, rgba(50, 50, 93, 0.25) 0px 50px 100px -20px, rgba(0, 0, 0, 0.3) 0px 30px 60px -30px;
        margin-right: 2%;
        overflow: hidden;
        border-radius: 7px;
    }

    .service-columns-image {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: 30px 25px;
        transition: all 0.3s ease-in-out;
    }

    .icon-image {
        width: 50px;
        height: 50px;
    }

    .service-title {
        margin: 10px 0;
        font-size: 20px;
        font-weight: 700;
    }
    .service-description.description {
        margin-top: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
    }
    .section-{{ section.id }}.service-columns-section {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .desktop{
        display:flex!important;
    }
    .mobile{
        display:none!important;
    }
    @media screen and (max-width: 980px) {
        .section-{{ section.id }}.service-columns-section {
      padding-top: {{ section.settings.padding_top_tablet }}px;
      padding-bottom: {{ section.settings.padding_bottom_tablet }}px;
    }
    .service-columns-content {
    flex-direction: column;
    margin-bottom: 25px;
    }

    .service-columns-description {
        padding-left: 0;
    }

    .heading-all.service-heading {
        margin: 0 0 15px 0;
    }

    a.service-button.button-y {
        width: 48%;
    }

    .service-columns-button {
        display: flex;
        justify-content: space-between;
    }

    .service-columns-image-background {
        min-width: 45%;
        max-width: 45%;
        margin-right: 2%;
    }

    p.description.service-description {
        text-align: center;
    }

    .service-columns-image-item {
        justify-content: start;
        overflow: scroll;
    }
    ::-webkit-scrollbar {
        display: none;
    }
  }
  @media screen and (max-width: 580px) {
    .section-{{ section.id }}.service-columns-section {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    .heading-all.service-heading {
    text-align: center;
    }
    .service-button.button-y {
        width: 100%!important;
    }
    .service-columns-button {
        flex-direction: column;
    }
    .service-columns-image-background {
        min-width: 65%;
        max-width: 65%;
        margin-right: 4%;
    }
    .service-columns-content {
        margin-bottom: 15px;
    }
    .desktop{
        display:none!important;
    }
    .mobile{
        display:block!important;
        margin-top:35px;
    }
  }
{%- endstyle-%}
<section class="section-{{section.id }} service-columns-section" style="{% if section.settings.image_background != blank %}background-image: url('{{ section.settings.image_background | image_url }}'); {% else %} background: {{ section.settings.bg_color }}; {% endif %}">
    <div class="service-columns-container page-width">
        <div class="service-columns-content">
            {% if section.settings.heading != blank %} <h2 style="color:{{ section.settings.heading_color }};" class="heading-all service-heading h1"> {{ section.settings.heading }} </h2> {% endif %}
            <div class="service-columns-description">
                {% if section.settings.description != blank %} <p style="color:{{ section.settings.description_color }};" class="description service-description">{{ section.settings.description }}</p> {% endif %}
                <div class="service-columns-button desktop">
                    {% if section.settings.button_text1 != blank %}<a style="color:{{ section.settings.button_text_color }}; background: {{ section.settings.button_background_color }}" class="service-button button-y button button--primary" href="{{ section.settings.button_url1 }}">{{ section.settings.button_text1 }}</a> {% endif %}
                    {% if section.settings.button_text2 != blank %}<a style="color:{{ section.settings.button_text_color2 }}; background: {{ section.settings.button_background_color2 }}" class="service-button button-y button button--primary" href="{{ section.settings.button_url2 }}">{{ section.settings.button_text2 }}</a> {% endif %}
                </div>
            </div>
        </div>
            <div class="service-columns-image-item">
            {%- for block in section.blocks -%}
                    <div class="service-columns-image-background" style="background-image: url('{{ block.settings.column_image | image_url }}');">
                        <style>
                            .service-columns-image:hover {
                                background: #000000a6 !important;
                                transition: all 0.3s ease-in-out;
                            }
                            .service-columns-image:hover  a.service-title, .service-columns-image:hover a.service-description.description {
                                color: {{ block.settings.hover_text_color}}!important;
                                transition: all 0.3s ease-in-out;
                            }
                            .service-columns-image:hover a.service-description.description {
                                transition: all 0.3s ease-in-out;
                            }
                            .service-columns-image:hover .icon-image.two{
                                display:block!important;
                            }
                            .service-columns-image:hover .icon-image{
                                display:none;
                            }
                        </style>    
                        <div class="service-columns-image" style="background: {{ block.settings.background_color }}">
                                <img src="{{ block.settings.icon_image | image_url }}" alt="icon-image" class="icon-image">
                                <img src="{{ block.settings.icon_image2 | image_url }}" alt="icon-image" class="icon-image two" style="display:none;">
                                {% if block.settings.column_title != blank %}
                                    <a style="color:{{ block.settings.title_color }};" class="service-title">{{ block.settings.column_title }}</a>
                                {% endif %}
                                {% if block.settings.description != blank %}
                                    <a style="color:{{ block.settings.description_color }};" class="service-description description">{{ block.settings.description }}</a>
                                {% endif %}
                            </div>
                    </div>
            {%- endfor -%}
            </div>
            <div class="service-columns-button mobile">
                {% if section.settings.button_text1 != blank %}<a style="color:{{ section.settings.button_text_color }}; background: {{ section.settings.button_background_color }}" class="service-button button-y button button--primary" href="{{ section.settings.button_url1 }}">{{ section.settings.button_text1 }}</a> {% endif %}
                {% if section.settings.button_text2 != blank %}<a style="color:{{ section.settings.button_text_color2 }}; background: {{ section.settings.button_background_color2 }}" class="service-button button-y button button--primary" href="{{ section.settings.button_url2 }}">{{ section.settings.button_text2 }}</a> {% endif %}
            </div>
    </div>
</section>
{% schema %}
{
    "name": "Multi Column Slider",  
    "settings": [
        {
            "type": "image_picker",
            "id": "image_background",
            "label": "Image Background",
            "info": "Note that Background image will be prioritized over background color if both has value"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Lorem ipsum dolor sit amet"
        },
        {
            "type": "text",
            "id": "description",
            "label": "Description",
            "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec et faucibus quam, sed aliquet mi. Vestibulum nulla lectus, fringilla ac magna vitae, bibendum facilisis urna. Nunc feugiat eleifend lacus, vitae consequat dui pulvinar at. Suspendisse lobortis faucibus mattis. Quisque ac augue et nisl pretium tincidunt. Donec quis consectetur diam. "
        },
        {
            "type": "text",
            "id": "button_text1",
            "label": "First Button text",
            "default": "View All"
        },
        {
            "type": "url",
            "id": "button_url1",
            "label": "First Button Link"
        },
        {
            "type": "text",
            "id": "button_text2",
            "label": "Second Button text",
            "default": "Contact Us"
        },
        {
            "type": "url",
            "id": "button_url2",
            "label": "Second Button Link"
        },
        {
            "type": "header",
            "content": "Color Area"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "info": "Note that Background image will be prioritized over background color if both has value"
        },
        {
            "type": "color",
            "id": "heading_color",
            "label": "Heading Color"
        },
        {
            "type": "color",
            "id": "description_color",
            "label": "Description Color"
        },
        {
            "type": "color",
            "id": "button_text_color",
            "label": "First Button Text Color"
        },
        {
            "type": "color",
            "id": "button_background_color",
            "label": "First Button Background Color"
        },
        {
            "type": "color",
            "id": "button_text_color2",
            "label": "Second Button Text Color"
        },
        {
            "type": "color",
            "id": "button_background_color2",
            "label": "Second Button Background Color"
        },
        {
            "type": "header",
            "content": "t:sections.all.padding.section_padding_heading"
          },
          {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 80
          },
          {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 80
          },
          {
            "type": "range",
            "id": "padding_top_tablet",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Tablet Padding Top",
            "default": 50
          },
          {
            "type": "range",
            "id": "padding_bottom_tablet",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Tablet Padding Bottom",
            "default": 50
          },
          {
            "type": "range",
            "id": "padding_top_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Mobile Padding Top",
            "default": 30
          },
          {
            "type": "range",
            "id": "padding_bottom_mobile",
            "min": 0,
            "max": 100,
            "step": 1,
            "unit": "px",
            "label": "Mobile Padding Bottom",
            "default": 30
          }

    ],
    "blocks": [
        {
            "name": "Column",
            "type": "column",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "column_image",
                    "label": "Column Image Background"
                },
                {
                    "type": "image_picker",
                    "id": "icon_image",
                    "label": "Column Image Icon"
                },
                {
                    "type": "image_picker",
                    "id": "icon_image2",
                    "label": "Column Image Icon Hover"
                },
                {
                    "type": "text",
                    "id": "column_title",
                    "label": "Column Title",
                    "default": "Column Title"
                },
                {
                    "type": "url",
                    "id": "column_link",
                    "label": "Column Link"
                },
                {
                    "type": "text",
                    "id": "description",
                    "label": "Description"
                },
                {
                    "type": "header",
                    "content": "Color Area"
                },
                {
                    "type": "color",
                    "id": "background_color",
                    "label": "Background Color"
                },
                {
                    "type": "color",
                    "id": "title_color",
                    "label": "Title Color"
                },
                {
                    "type": "color",
                    "id": "description_color",
                    "label": "Description Color"
                },
                {
                    "type": "color",
                    "id": "hover_text_color",
                    "label": "Hover Text Color"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Multi Column Slider",
            "category": "Column"
        }
    ]
} 
{% endschema %}