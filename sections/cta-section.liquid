{% style %}
    .cta-container{
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        padding-top: {{ section.settings.padding_top }}px!important;
        padding-bottom: {{ section.settings.padding_bottom }}px!important;
        margin-top: {{ section.settings.margin_top }}px!important;
        margin-bottom: {{ section.settings.margin_bottom }}px!important;
        border-radius: 7px 7px 15px 15px;
        overflow: hidden;
    }
    .cta-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .cta-title.heading1 {
        text-align: center;
        width: 80%;
        text-transform: capitalize;
    }

    .cta-button.button-y {
        margin-top: 25px;
    }
        @media screen and (max-width: 980px) {
            .cta-container {
        padding-top: {{ section.settings.padding_top_tablet }}px!important;
        padding-bottom:
         {{ section.settings.padding_bottom_tablet }}px!important;
         margin-top: {{ section.settings.margin_top_tablet }}px!important;
         margin-bottom:
         {{ section.settings.margin_bottom_tablet }}px!important;
        }
        section.cta-section.page-width {
            padding-left: 0!important;
            padding-right: 0!important;
        }
        .cta-title.heading1 {
            width: 100%;
        }
    }
        @media screen and (max-width: 580px) {
            .cta-container {
        padding-top: {{ section.settings.padding_top_mobile }}px!important;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px!important;
        margin-top: {{ section.settings.margin_top_mobile }}px!important;
        margin-bottom: {{ section.settings.margin_bottom_mobile }}px!important;
        }
    }
{% endstyle %}

<section class="cta-section page-width">
    <div class="cta-container" style="{% if section.settings.background_image != blank %}background-image: url('{{ section.settings.background_image | image_url }}'); {% else %} background: {{ section.settings.background_color }}; {% endif %}">
        <div class="cta-content">
            {% if section.settings.heading != blank %}<h1 class="cta-title heading1" style="color:{{ section.settings.heading_color }}">{{ section.settings.heading }}</h1> {% endif %}
            {% if section.settings.subheading != blank %}<p class="cta-description description" style="color:{{ section.settings.subheading_color }}">{{ section.settings.subheading }}</p> {% endif %}
            {% if section.settings.button_text != blank %}<a style="color:{{ section.settings.button_text_color }}; background: {{ section.settings.button_color }}" class="cta-button button-y" href="{{ section.settings.button_url }}">{{ section.settings.button_text }}</a> {% endif %}
                    
        </div>
    </div>
</section>
{% schema %}
