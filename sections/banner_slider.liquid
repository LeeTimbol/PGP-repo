<style>
    .banner-slider {
        height: 70vh;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .banner-slider-column {
        display: flex;
    }
    .banner-slider-columnText {
        display: flex;
        flex-direction: column;
    }
    .banner-slider-column-wrapper {
        display: flex;
        overflow: hidden;
        flex-wrap: nowrap;
        align-items: center;
        justify-content: space-between;

    }
    .banner-slider-column {
        width: 100%;
    }
    .banner-slider-columnImage {
        width: 100%;
        max-width: 48%;
    }
    img.column-image {
        width: 100%;
    }
    .banner-slider-section .flickity-page-dots {
        bottom: 25px;
        z-index: 2;
    }
    
    .banner-slider-section .flickity-page-dot {
        width: 25px;
        height: 8px;
        border-radius: 5px;
        opacity: 0.5;
        background: {{ section.settings.arrow_color }};
    }
    
    .banner-slider-section .flickity-page-dot.is-selected {
        width: 35px;
        background: {{ section.settings.arrow_color }};
        opacity: 1;
    }
    @media only screen and (max-width: 980px) {
        .banner-slider-columnImage {display: none!important;}

        .banner-slider-column {
            max-width: 100%!important;
        }

        .banner-slider {
            height: 60vh;
        }
    }
    @media only screen and (max-width: 580px) {
        .banner-slider {
            max-height:unset;
            padding: 30px 0 50px 0;
            height: 55vh;
        }
    }
</style>
<section class="banner-slider-section">
{%- for block in section.blocks -%}
<div class="banner-slider" style="{% if block.settings.image_background != blank %}background-image: url('{{ block.settings.image_background | image_url }}'); {% else %} background: {{ block.settings.background_color }}; {% endif %}">
        <div class="banner-slider-container page-width">
           <div class="banner-slider-column-wrapper" style="{% if block.settings.image_alignment == "Left" %} flex-direction: row-reverse; {% else %} flex-direction: row; {% endif %}">
                <div class="banner-slider-column" style="{% if block.settings.column_image == blank %} justify-content: {{ block.settings.column_alignment }}; text-align: {{ block.settings.column_alignment }}; max-width:100%; {% else %} max-width:48%; {% endif %}">
                    <div class="banner-slider-columnText" style="{% if block.settings.column_image == blank %} align-items: {{ block.settings.column_alignment }}; text-align: {{ block.settings.column_alignment }}; width:48%; {% endif %}">
                        {% if block.settings.heading != blank %}<h1 class="banner-slider-title heading1" style="color:{{ block.settings.heading_color }}">{{ block.settings.heading }}</h1> {% endif %}
                        {% if block.settings.description != blank %}<p class="banner-slider-description description" style="color:{{ block.settings.description_color }}">{{ block.settings.description }}</p> {% endif %}
                        {% if block.settings.button_text != blank %}<a style="color:{{ block.settings.button_text_color }}; background: {{ block.settings.button_background_color }}" class="banner-slider-button button-y" href="{{ block.settings.button_url }}">{{ block.settings.button_text }}</a> {% endif %}
                    </div>
                </div>    
                <div class="banner-slider-columnImage" style="{% if block.settings.column_image != blank %} display:block; {% else %} display:none; {% endif %}">
                    <img src="{{ block.settings.column_image | image_url }}" alt="icon-image" class="column-image">
                </div>
           </div>
        </div>
</div>
{%- endfor -%}
</section>
{% schema %}
{
    "name": "Banner Slider",  
    "settings": [
        {
            "type": "header",
            "content": "Slider Settings"
        },
        {
            "type": "checkbox",
            "id": "dots",
            "label": "Show Slider Dots",
            "default": true
        },
        {
            "type": "color",
            "id": "Button_color",
            "label": "Button Color"
        },
        {
            "type": "color",
            "id": "arrow_color",
            "label": "Button Color",
            "default":"#FBC60A"
        }
    ],
    "blocks": [
        {
            "name": "Banner Slide",
            "type": "banner_slider",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image_background",
                    "label": "Image Background"
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading",
                    "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
                },
                {
                    "type": "text",
                    "id": "description",
                    "label": "Description",
                    "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec et faucibus quam, sed aliquet mi. Vestibulum nulla lectus, fringilla ac magna vitae, bibendum facilisis urna. Nunc feugiat eleifend lacus, vitae consequat dui pulvinar at. Suspendisse lobortis faucibus mattis. Quisque ac augue et nisl pretium tincidunt. Donec quis consectetur diam. "
                },
                {
                    "type": "text",
                    "id": "button_text",
                    "label": "Button text",
                    "default": "SHOP NOW"
                },
                {
                    "type": "url",
                    "id": "button_url",
                    "label": "Button Link"
                },
                {
                    "type": "image_picker",
                    "id": "column_image",
                    "label": "Column Image"
                },
                {
                    "type": "select",
                    "id": "column_alignment",
                    "options": [
                      {
                        "value": "Left",
                        "label": "Left"
                      },
                      {
                        "value": "Right",
                        "label": "Right"
                      },
                      {
                        "value": "Center",
                        "label": "Center"
                      }
                    ],
                    "default": "Left",
                    "label": "Left",
                    "info": "Center will be applied only if there is no Column Image"
                  },
                {
                        "type": "select",
                        "id": "image_alignment",
                        "options": [
                          {
                            "value": "Left",
                            "label": "Left"
                          },
                          {
                            "value": "Right",
                            "label": "Right"
                          }
                        ],
                        "default": "Right",
                        "label": "Right"
                      },
                    {
                    "type": "header",
                    "content": "Color Area"
                },
                {
                    "type": "color",
                    "id": "background_color",
                    "label": "Background Color"
                },
                {
                    "type": "color",
                    "id": "heading_color",
                    "label": "Heading Color"
                },
                {
                    "type": "color",
                    "id": "description_color",
                    "label": "Description Color"
                },
                {
                    "type": "color",
                    "id": "button_text_color",
                    "label": "Button Text Color"
                },
                {
                    "type": "color",
                    "id": "button_background_color",
                    "label": "Button Background Color"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Banner Slider",
            "category": "Banner"
        }
    ]
} 
{% endschema %}